# Prometheus Operator — run on control-plane (t3.medium) to spare t3.micro workers
prometheusOperator:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 200m
      memory: 256Mi

prometheus:
  prometheusSpec:
    tolerations:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
    nodeSelector:
      node-role.kubernetes.io/control-plane: ""
    resources:
      requests:
        cpu: 200m
        memory: 400Mi
      limits:
        cpu: 1000m
        memory: 1Gi
    retention: 7d
    # Scrape KEDA operator metrics (keda_scaler_metrics_value, keda_scaler_active, etc.)
    # Porta 9666 confirmada ao vivo em 2026-08-17 (kubectl get svc -n keda keda-operator
    # -> port: 9666, name: metricsservice) — a porta 8080 anterior nunca tinha sido
    # validada de fato (o comentario original so' dizia "validar depois"; o KEDA 2.14.3
    # usa 9666, nao 8080). Prometheus ficava com o target keda-operator permanentemente
    # "down" (context deadline exceeded) sem isso.
    additionalScrapeConfigs:
      - job_name: keda-operator
        static_configs:
          - targets:
              - keda-operator.keda.svc.cluster.local:9666

grafana:
  enabled: true
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
  # memory limit dobrado de 256Mi -> 512Mi (achado ao vivo em 2026-08-19, ver
  # RUNBOOK-deploy-do-zero.md Apendice A.12): 256Mi era insuficiente para a
  # indexacao bleve (unified storage) do Grafana no boot, causando estouro de
  # memoria -> liveness probe falhando -> kubelet reiniciando o pod em loop
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi
  service:
    type: NodePort
  adminPassword: "{{ grafana_admin_password }}"

alertmanager:
  enabled: true
  alertmanagerSpec:
    tolerations:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
    nodeSelector:
      node-role.kubernetes.io/control-plane: ""
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

# node-exporter DaemonSet — runs on ALL nodes to collect per-node infra metrics
# (CPU, memory, disk, network per node — replaces Metricbeat infra metrics)
prometheus-node-exporter:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

# kube-state-metrics — cluster state (deployments, pods, nodes, DaemonSets, etc.)
kube-state-metrics:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi
