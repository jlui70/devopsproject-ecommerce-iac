image: docker.elastic.co/beats/metricbeat-oss
imageTag: "7.10.2"

kube_state_metrics:
  enabled: true

daemonset:
  metricbeatConfig:
    metricbeat.yml: |
      setup.template.enabled: false
      setup.ilm.enabled: false

      metricbeat.modules:
      - module: kubernetes
        metricsets:
          - container
          - node
          - pod
          - system
          - volume
        period: 30s
        host: "${NODE_NAME}"
        hosts: ["https://${NODE_IP}:10250"]
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        ssl.verification_mode: none

      - module: system
        metricsets: ["cpu", "load", "memory", "network", "process", "process_summary"]
        period: 30s
        process.include_top_n:
          by_cpu: 5
          by_memory: 5

      output.elasticsearch:
        hosts: ["https://{{ opensearch_endpoint }}:443"]
        username: "${OPENSEARCH_USERNAME}"
        password: "${OPENSEARCH_PASSWORD}"
        ssl.verification_mode: none
        index: "metricbeat-%{+yyyy.MM.dd}"

  extraEnvs:
    - name: OPENSEARCH_USERNAME
      valueFrom:
        secretKeyRef:
          name: opensearch-credentials
          key: username
    - name: OPENSEARCH_PASSWORD
      valueFrom:
        secretKeyRef:
          name: opensearch-credentials
          key: password
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    - name: NODE_IP
      valueFrom:
        fieldRef:
          fieldPath: status.hostIP

  resources:
    requests:
      cpu: 100m
      memory: 200Mi
    limits:
      cpu: 300m
      memory: 512Mi

  # Run only on control-plane nodes (t3.medium 4GB) to avoid OOM on t3.micro workers
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""

deployment:
  metricbeatConfig:
    metricbeat.yml: |
      setup.template.enabled: false
      setup.ilm.enabled: false

      metricbeat.modules:
      - module: kubernetes
        metricsets:
          - state_node
          - state_deployment
          - state_daemonset
          - state_replicaset
          - state_pod
          - state_container
          - state_statefulset
          - event
        period: 30s
        hosts: ["metricbeat-kube-state-metrics:8080"]

      output.elasticsearch:
        hosts: ["https://{{ opensearch_endpoint }}:443"]
        username: "${OPENSEARCH_USERNAME}"
        password: "${OPENSEARCH_PASSWORD}"
        ssl.verification_mode: none
        index: "metricbeat-%{+yyyy.MM.dd}"

  extraEnvs:
    - name: OPENSEARCH_USERNAME
      valueFrom:
        secretKeyRef:
          name: opensearch-credentials
          key: username
    - name: OPENSEARCH_PASSWORD
      valueFrom:
        secretKeyRef:
          name: opensearch-credentials
          key: password

  resources:
    requests:
      cpu: 100m
      memory: 200Mi
    limits:
      cpu: 300m
      memory: 512Mi

  # Run only on control-plane nodes (t3.medium 4GB) to avoid OOM on t3.micro workers
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
